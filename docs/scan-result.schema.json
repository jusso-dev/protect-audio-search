{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/protect-audio-search/docs/scan-result.schema.json",
  "title": "protect-audio-search scan result",
  "description": "JSON written by protect-audio-search scan --json. Event start and end use the scan timezone. start_utc and end_utc are the requested range in UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "camera", "timezone", "start_utc", "end_utc", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "camera": { "type": "string" },
    "timezone": { "type": "string" },
    "start_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "end_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera",
          "start",
          "end",
          "peak_class",
          "peak_score",
          "mean_score",
          "contributing_classes",
          "clip",
          "snapshots",
          "confirmation"
        ],
        "properties": {
          "camera": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "peak_class": { "type": "string" },
          "peak_score": { "type": "number" },
          "mean_score": { "type": "number" },
          "contributing_classes": { "type": "array", "items": { "type": "string" } },
          "clip": { "type": ["string", "null"] },
          "snapshots": { "type": "array", "items": { "type": "string" } },
          "confirmation": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "vehicle_present",
                  "smoke_present",
                  "plate_text",
                  "plate_confidence",
                  "note"
                ],
                "properties": {
                  "vehicle_present": { "type": ["boolean", "null"] },
                  "smoke_present": { "type": ["boolean", "null"] },
                  "plate_text": { "type": ["string", "null"] },
                  "plate_confidence": { "type": ["number", "null"] },
                  "note": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
