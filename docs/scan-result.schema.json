{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/protect-audio-search/docs/scan-result.schema.json",
  "title": "protect-audio-search scan result",
  "description": "JSON written by protect-audio-search scan --json, and as results.json in the review folder. Event start and end use the scan timezone. start_utc and end_utc are the requested range in UTC. run says what the scan covered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "camera",
    "timezone",
    "start_utc",
    "end_utc",
    "run",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "tool_version": {
      "type": "string"
    },
    "camera": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "start_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "end_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "run": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "settings",
            "chunks_planned",
            "chunks_scored",
            "chunks_without_audio",
            "chunks_failed",
            "chunks_short_audio",
            "review_dir"
          ],
          "properties": {
            "settings": {
              "type": "object",
              "description": "Detection and export settings used for this run."
            },
            "chunks_planned": {
              "type": "integer",
              "minimum": 0
            },
            "chunks_scored": {
              "type": "integer",
              "minimum": 0
            },
            "chunks_without_audio": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start_utc",
                  "end_utc"
                ],
                "properties": {
                  "start_utc": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  },
                  "end_utc": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  }
                }
              }
            },
            "chunks_failed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start_utc",
                  "end_utc",
                  "error"
                ],
                "properties": {
                  "start_utc": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  },
                  "end_utc": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            },
            "chunks_short_audio": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start_utc",
                  "end_utc"
                ],
                "properties": {
                  "start_utc": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  },
                  "end_utc": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  }
                }
              }
            },
            "review_dir": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "camera",
          "start",
          "end",
          "peak_class",
          "peak_score",
          "mean_score",
          "contributing_classes",
          "clip",
          "snapshots",
          "confirmation",
          "media_error"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "description": "Matches the clip and snapshot file numbers."
          },
          "camera": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "peak_class": {
            "type": "string"
          },
          "peak_score": {
            "type": "number"
          },
          "mean_score": {
            "type": "number"
          },
          "contributing_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "clip": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confirmation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "vehicle_present",
                  "smoke_present",
                  "plate_text",
                  "plate_confidence",
                  "note"
                ],
                "properties": {
                  "vehicle_present": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "smoke_present": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "plate_text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "plate_confidence": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "media_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why a clip or snapshot for this event could not be written."
          }
        }
      }
    }
  }
}
